      "frequency_rule": "band_min_hz <= carrier_hz <= band_max_hz",
      "frequency_model": "channel-integrated BPSK proxy",
      "doppler": "radial velocity from SGP4 topocentric state",
      "occupied_bandwidth": "BPSK sinc\u00b2 narrow/broad mixture; not an exact composite ICD waveform"
