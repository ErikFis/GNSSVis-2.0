    "planetary_ephemeris_required": true,
    "network_access_allowed": true
  },
  "passages": {
    "definition": "Runs inside the elliptical half-power contour at reference frequency and above horizon. Emission includes Gaussian wings.",
    "entry_time": "first included sample",
    "exit_time_exclusive": "first following excluded sample, or the observation end when clipped",
    "duration": "number_of_included_samples * step_seconds",
    "subsample_interpolation": false,
    "clipping_flags": [
      "entry_clipped",
      "exit_clipped"
    ]
  },
  "randomness": {
    "enabled": true,
    "seed": 42,
    "generator": "numpy.random.default_rng",
    "reproducibility": "Same seed, effective configuration, and dependency versions reproduce the generated arrays. Record versions and use stated tolerances across environments."
  },
  "output": {
    "default_directory": "outputs/pibic_24h",
    "encoding": "UTF-8",
    "csv_delimiter": ",",
    "timestamp_format": "ISO 8601 UTC with Z suffix",
    "samples_file": "samples.csv",
    "passages_file": "passages.csv",
    "metadata_file": "metadata.json",
    "measured_observation_input_required": false,
    "fits_output_required": false,
    "waterfall_file": "waterfall.npz",
    "figure_file": "waterfall.png",
    "array_dtype": "float32 for generated power arrays",
    "axis_dtype": "float64 for frequency centers; integer UTC time offsets from start",
    "npz_arrays": [
      "noise_power",
      "signal_power",
      "total_power",
      "frequencies_hz",
      "time_offsets_seconds"
    ],
    "power_array_order": "frequency,time",
    "power_unit": "relative linear power; never sum in dB",
    "plot_export_required": true
  },
  "path_rules": {
    "reference_paths": "relative to the repository root, not the caller working directory",
    "output_directory": "default from this file; an explicit CLI output override is permitted"
  },
  "frequency_grid": {
    "channel_count": 768,
    "channel_placement": "uniform bin centers spanning the receiver band",
    "frequency_axis_unit": "Hz"
  },
  "noise": {
    "model": "independent_averaged_white_noise_power",
    "mean_power_relative": 1.0,
    "averages": 16,
    "distribution": "Gamma(shape=averages, scale=mean_power_relative/averages)",
    "interpretation": "Equivalent power statistics of averaged independent complex Gaussian white-noise samples; no voltage waveform or FFT is required. Power pixels are not Gaussian.",
    "antenna_temperature_model": false,
    "receiver_electronics_model": false
  },
  "emission": {
    "model": "relative_gaussian_carrier_power",
    "profile_key": "satellite_catalog.block",
    "profiles": {
      "IIF": {
        "peak_power_relative_at_reference_range": 20.0,
        "reference_range_m": 20000000.0,
        "spectral_sigma_hz": 500000.0,
        "spectral_cutoff_sigma": 3.0
      },
      "III": {
        "peak_power_relative_at_reference_range": 20.0,
        "reference_range_m": 20000000.0,
        "spectral_sigma_hz": 500000.0,
        "spectral_cutoff_sigma": 3.0
      },
      "IIR": {
        "peak_power_relative_at_reference_range": 20.0,
        "reference_range_m": 20000000.0,
        "spectral_sigma_hz": 500000.0,
        "spectral_cutoff_sigma": 3.0
      }
    },
    "range_scaling": "(reference_range_m / topocentric_range_m) ** 2",
    "angular_gain": "exp(-4 * ln(2) * (angular_separation_deg / beam.full_width_deg) ** 2)",
    "time_support": "Only samples inside the configured beam selection gate and above the horizon.",
    "spectral_profile": "exp(-0.5 * ((frequency_hz-carrier_hz)/spectral_sigma_hz)**2), truncated outside spectral_cutoff_sigma*spectral_sigma_hz",
    "carrier_selection": "Inject only nominal carrier centers inside the receiver band.",
    "combination": "Add independent satellite/carrier contributions in linear relative power.",
    "calibration": "Illustrative equal profile coefficients for IIF and III, not measured EIRP, dBm, or block-specific calibrated power.",
    "measurement_models_excluded": [
      "actual GPS modulation",
      "Doppler",
      "polarization",
      "antenna thermal noise",
      "receiver electronics",
      "multipath"
    ]
  },
  "display": {
    "layout": "GNSSVis-style upper passage panel, lower waterfall, right-hand satellite/color table, and horizontal colorbar",
    "upper_y_axis": "angular_separation_deg",
    "beam_boundary_line": true,
    "frequency_axis": "MHz",
    "time_axis": "UTC",
    "carrier_marker_linestyle": ":",
    "carrier_markers": "One dotted horizontal line and label per in-band nominal carrier, not duplicate lines for satellites sharing that carrier.",
    "intensity": "10*log10(total_power_relative/noise.mean_power_relative)",
    "intensity_label": "Relative power [dB re configured mean background]",
    "shared_geometry": "Use the same time grid and passage masks for synthesis and both panels.",
    "interactive_show": false,
    "color_limits": "Full finite range of the displayed total-power dB array; do not clip narrow transient signals using background-dominated percentiles."
  },
  "matrix_contract": {
    "rank": 2,
    "dimension_order": [
      "frequency",
      "time"
    ],
    "shape_rule": [
      "frequency_grid.channel_count",
      "time_grid.duration_seconds / time_grid.step_seconds"
    ],
    "validation": "Require positive grid sizes and duration_seconds to be an exact multiple of step_seconds.",
    "row_axis": {
      "index": "i = 0 .. channel_count-1",
      "quantity": "frequency",
      "coordinate_array": "frequencies_hz",
      "storage_unit": "Hz",
      "storage_dtype": "float64",
      "formula": "band_min_hz + (i + 0.5) * (band_max_hz - band_min_hz) / channel_count",
      "display_axis": "Y",
      "display_unit": "MHz"
    },
    "column_axis": {
      "index": "j = 0 .. duration_seconds/step_seconds-1",
      "quantity": "time",
      "coordinate_array": "time_offsets_seconds",
      "storage_unit": "seconds since time_grid.start_utc",
      "storage_dtype": "int64",
      "formula": "j * step_seconds",
      "absolute_timestamp": "time_grid.start_utc + time_offsets_seconds[j] seconds, interpreted in UTC",
      "interval": "start included, observation end excluded",
      "display_axis": "X",
      "display_format": "UTC date and time"
    },
    "cell_values": {
      "indexing": "power[i,j] is power in frequency channel i at time sample j",
      "arrays": [
        "noise_power",
        "signal_power",
        "total_power"
      ],
      "storage_unit": "relative linear power; same normalization for all three arrays",
      "storage_dtype": "float32",
      "combination": "total_power[i,j] = noise_power[i,j] + signal_power[i,j]",
      "display_encoding": "color, not a third array dimension",
      "display_formula": "10 * log10(total_power[i,j] / noise.mean_power_relative)",
      "display_unit": "dB relative to configured mean background power",
      "not_units": [
        "dBm",
        "watts",
        "voltage"
      ]
    }
  },
  "realistic_emission": {
    "model": "channel_averaged_bpsk_proxy",
    "peak_power_relative": 24.0,
    "reference_range_m": 20000000.0,
    "narrow_chip_rate_hz": 1023000.0,
    "broad_chip_rate_hz": 10230000.0,
    "broad_fraction": 0.32,
    "note": "Illustrative equal amplitudes; IIR/IIR-M have no L5 in this model."
