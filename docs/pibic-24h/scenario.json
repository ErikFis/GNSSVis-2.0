{
  "schema_version": 2,
  "scenario_id": "pibic_gps_sun_24h_20260821",
  "purpose": "Illustrative 24-hour simulation for the radio astronomy community; no BINGO affiliation or measured observation.",
  "time_grid": {
    "start_utc": "2026-08-21T06:00:00Z",
    "duration_seconds": 86400,
    "step_seconds": 60,
    "interval": "left_closed_right_open",
    "time_scale": "UTC"
  },
  "observatory": {
    "name": "Configurable reference site in Para\u00edba; illustrative coordinates",
    "latitude_deg": -7.211637,
    "longitude_deg": -35.908138,
    "elevation_m": 553.0,
    "earth_model": "WGS84",
    "elevation_convention": "Treat elevation_m as WGS84 ellipsoidal height for this reference simulation.",
    "coordinate_source": "GNSSVis SkyAnalyzer defaults; not independently surveyed here."
  },
  "pointing": {
    "mode": "fixed_altaz",
    "azimuth_deg": 59.819450293397324,
    "altitude_deg": 52.01669995994202,
    "azimuth_convention": "degrees east of north"
  },
  "beam": {
    "model": "chromatic_elliptical_gaussian",
    "full_width_deg": 50.0,
    "inside_rule": "gain_at_reference_frequency >= 0.5",
    "minimum_altitude_deg": 0.0,
    "refraction": "none",
    "selection_note": "Elliptical half-power contour at reference frequency; full Gaussian tails synthesized above horizon.",
    "minor_width_deg": 40.0,
    "reference_frequency_hz": 1575420000.0,
    "position_angle_deg": 0
  },
  "receiver": {
    "band_min_hz": 1150000000.0,
    "band_max_hz": 1600000000.0,
    "frequency_rule": "band_min_hz <= carrier_hz <= band_max_hz",
    "frequency_model": "channel-integrated BPSK proxy",
    "doppler": "radial velocity from SGP4 topocentric state",
    "occupied_bandwidth": "BPSK sinc\u00b2 narrow/broad mixture; not an exact composite ICD waveform"
  },
  "references": {
    "tle_file": "reference_data/pibic_24h/satellites.tle",
    "satellite_catalog_file": "reference_data/pibic_24h/satellites.csv",
